{
  "version": 2,
  "name": "notelab",
  "builds": [
    {
      "src": "vite.config.js",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "renderer/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/renderer/dist/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "@notelab_api_url"
  }
}
